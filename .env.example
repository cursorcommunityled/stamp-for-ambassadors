# Copy to .env to run on your laptop. On Render, set these in the dashboard
# instead (see the README).
#
# Required locally: DATABASE_URL, SHADOW_DATABASE_URL, AUTH_SECRET, ADMIN_EMAILS.

# Postgres from `npm run db:start`. Then `npm run db:setup` creates these two
# databases. If your ports differ, check `npx prisma dev ls`. The shadow is
# the next port up.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/stamp?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/stamp_shadow?sslmode=disable"

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production needs 32+ random characters. Changing it signs everyone out.
AUTH_SECRET=""

# Comma-separated. These addresses manage every event and confirm new hosts.
# Locally, put the email you sign in with.
ADMIN_EMAILS=""

# Only needed to import a real Luma event. `npm run db:fake` works without it.
# Create it on the event's calendar: https://luma.com/calendar/manage/api-keys
LUMA_API_KEY=""

# Where sign-in links point. Keep localhost:3002 locally. On Render, leave it
# empty unless you use a custom domain.
APP_URL="http://localhost:3002"

# Optional. Your city's wording. Unset uses the Stamp defaults.
# APP_NAME="Stamp"
# APP_TAGLINE="Show up. Get stamped."
# FOOTER_CREDIT="Cursor Berlin"

# Deploy only. Your Resend key, and a sender on a domain it has verified.
# On a laptop, mail is never sent. Links print in the `npm run dev` terminal.
# RESEND_API_KEY=""
# EMAIL_FROM="Stamp <hello@yourcity.dev>"
